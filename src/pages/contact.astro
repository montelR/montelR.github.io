---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact" description="Connect with Montel Rice about AI systems, software reliability, infrastructure and professional opportunities.">
  <header class="page-head">
    <p class="eyebrow">Professional inquiries</p>
    <h1>Contact</h1>
    <p>I'm interested in opportunities involving AI systems, software reliability, automation and infrastructure. Connect with me on LinkedIn or explore my work on GitHub.</p>
  </header>
  <section class="section contact-section" aria-labelledby="connect-heading">
    <h2 id="connect-heading">Connect with me</h2>
    <div class="card-grid">
      <article class="card">
        <p class="eyebrow">Professional network</p>
        <h3>LinkedIn</h3>
        <p>For recruiting inquiries, professional conversations and career opportunities.</p>
        <a class="button primary" href="https://www.linkedin.com/in/montel-rice-6b89a544b">Connect on LinkedIn <span aria-hidden="true">↗</span></a>
      </article>
      <article class="card">
        <p class="eyebrow">Technical work</p>
        <h3>GitHub</h3>
        <p>Explore my public repositories, engineering examples and portfolio source.</p>
        <a class="button" href="https://github.com/montelR">View GitHub profile <span aria-hidden="true">↗</span></a>
      </article>
    </div>
  </section>
  <section class="section prose">
    <h2>Professional background</h2>
    <p>For more information about my experience, technical skills and independent projects, see my résumé and engineering case studies.</p>
    <div class="buttons"><a class="button" href="/resume/">View résumé</a><a class="button" href="/case-studies/">Explore case studies</a></div>
  </section>
</BaseLayout>
