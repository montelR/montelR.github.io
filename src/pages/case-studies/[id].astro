---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatusLabel from '../../components/StatusLabel.astro';
import EvidenceSummary from '../../components/EvidenceSummary.astro';
import {getCollection,render} from 'astro:content';
export async function getStaticPaths(){return (await getCollection('cases')).map(entry=>({params:{id:entry.id},props:{entry}}))}
const {entry}=Astro.props;const {Content}=await render(entry);
const evidence = {
  'agent-session-reliability': {items:[{value:'19/19',label:'Offline adversarial scenarios'},{value:'197/197',label:'Selected Python tests'},{value:'12/12',label:'Mac Debug XCTest'}],note:'Historical documented test checkpoints, not a new run or production-readiness claim. Distinct suites may overlap.'},
  'evaluation-release-gates': {items:[{value:'14',label:'Paired development cases'},{value:'28/28',label:'Expected case outcomes'},{value:'HOLD',label:'Release decision'}],note:'Historical matched evaluation; no human-time measurement or release clearance.'},
  'bounded-retrieval': {items:[{value:'47.6%',label:'Targeted source latency reduction'},{value:'62.6%',label:'Multi-file debugging reduction'},{value:'48.9%',label:'Architecture documentation reduction'}],note:'Historical median CLI wall-time reductions, not current benchmarks or token savings.'},
  'observable-infrastructure': {items:[{value:'88/88',label:'Backend tests'},{value:'16/16',label:'Focused diagnostic tests'},{value:'96.5%',label:'Selected noisy-output byte reduction'}],note:'Historical backend checkpoint and byte proxy, not current system health or measured token savings.'}
};
const metrics=evidence[entry.id];
const diagrams = {
 'bounded-retrieval': {caption:'Conceptual retrieval flow', lanes:[{label:'Read-only retrieval',steps:['Bounded request','Scope and revision checks','Provider adapter','Verified snapshot','Selected evidence']}]},
 'observable-infrastructure': {caption:'Separate observation and authority boundaries',lanes:[{label:'Infrastructure observation',steps:['Host and container readings','Read-only monitoring','Evidence and freshness']},{label:'Development-stage runtime',steps:['Primary model','Bounded specialist results','Explicit tool authorization','Permitted tool']}]}
};
const diagram=diagrams[entry.id];
---
<BaseLayout title={entry.data.title} description={entry.data.summary}><p class="breadcrumbs"><a href="/case-studies/">Case studies</a> / {entry.data.category}</p><header class="page-head"><p class="eyebrow">{entry.data.category}</p><h1>{entry.data.title}</h1><p>{entry.data.summary}</p><StatusLabel label={entry.data.status}/></header>{metrics && <EvidenceSummary items={metrics.items} note={metrics.note}/>} {diagram && <figure class="architecture-diagram"><figcaption>{diagram.caption}</figcaption>{diagram.lanes.map(lane=><section aria-label={lane.label}><p class="diagram-label">{lane.label}</p><ol>{lane.steps.map(step=><li>{step}</li>)}</ol></section>)}<p class="muted">Abstract responsibilities, not production topology or private configuration.</p></figure>}<article class="prose"><Content/></article></BaseLayout>
