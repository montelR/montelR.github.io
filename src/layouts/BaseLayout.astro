---
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
const { title = 'Engineering portfolio', description = 'Independent projects in AI systems, software quality and infrastructure.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="index, follow" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f5fa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#16121d" media="(prefers-color-scheme: dark)" />
    <title>{title} | Montel Rice</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Navigation />
    <main id="main" class="shell" tabindex="-1"><slot /></main>
    <Footer />
  </body>
</html>
