---
const items=[['/','Home'],['/about/','About'],['/projects/','Projects'],['/case-studies/','Case studies'],['/resume/','Résumé'],['/contact/','Contact']];
const path=Astro.url.pathname;
---
<header class="shell site-header">
  <a class="brand" href="/" aria-label="Montel Rice home">MR<span>.</span></a>
  <nav aria-label="Primary">
    {items.map(([url,label]) => <a href={url} aria-current={path===url?'page':undefined}>{label}</a>)}
  </nav>
</header>
